{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": ["src/**/*.css"]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "rules": {
      "preset": "none",
      "suspicious": {
        "noDuplicateProperties": "error",
        "noDuplicateCustomProperties": "error",
        "noShorthandPropertyOverrides": "error",
        "noEmptyBlock": "error",
        "noImportantInKeyframe": "error",
        "noDuplicateSelectors": "error"
      }
    }
  }
}
