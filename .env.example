# Optional: copy to .env.local and set your own X API bearer token.
# The token is read only by the local server. Never prefix it with VITE_.
X_BEARER_TOKEN=

# Optional: a separate high-entropy secret for media URL signing, so the API
# credential and the signing root can be rotated independently.
# When unset, the server derives the media signing key from X_BEARER_TOKEN.
X_MEDIA_SIGNING_SECRET=

# Optional: keep the old signing secret during a rotation until old URLs expire.
X_MEDIA_SIGNING_SECRET_PREVIOUS=

# Optional, server-only: private Vercel Blob for cache and site comments. Connect a private store
# in the Vercel project first; never use a VITE_ prefix or commit its real token.
BLOB_READ_WRITE_TOKEN=

# Server-only TouchGal metadata relay for StarryGal.
TOUCHGAL_API_TOKEN=
