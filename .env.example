# Optional: copy to .env.local and set your own X API bearer token.
# The token is read only by the local server. Never prefix it with VITE_.
X_BEARER_TOKEN=

# Optional: a separate high-entropy secret for media URL signing, so the API
# credential and the signing root can be rotated independently.
# When unset, the server derives the media signing key from X_BEARER_TOKEN.
X_MEDIA_SIGNING_SECRET=
