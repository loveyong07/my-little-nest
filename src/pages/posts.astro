---
import BaseLayout from "../layouts/BaseLayout.astro";
import { RouteHero } from "../components/RouteHero.jsx";
import PostCarousel from "../components/PostCarousel.jsx";
---

<BaseLayout title="初咏的小窝 · 动态" page="posts">
  <RouteHero client:load page="posts" />
  <section class="content-panel route-panel route-panel-posts" aria-label="日常动态 · X 原创帖">
    <PostCarousel client:visible />
  </section>
</BaseLayout>
