---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="页面未找到 · 初咏的小窝" page="home">
  <div style="min-height: 80vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 2rem; color: #4a5568;">
    <h1 style="font-family: var(--font-title); font-size: 5rem; margin-bottom: 0.5rem; color: #8e9aaf;">404</h1>
    <p style="font-size: 1.25rem; margin-bottom: 1.5rem; color: #718096;">抱歉，找不到这个页面呢 ~</p>
    <a href="/" style="display: inline-block; padding: 0.75rem 1.5rem; background: #8e9aaf; color: white; border-radius: 9999px; text-decoration: none; font-weight: 500; transition: opacity 0.2s;" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">返回首页</a>
  </div>
</BaseLayout>
