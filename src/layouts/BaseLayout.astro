---
import { ClientRouter } from "astro:transitions";
import { ClickSparkles } from "../components/ClickSparkles.jsx";
import { ASSETS } from "../constants/site.js";
import "../styles.css";

interface Props {
  title?: string;
  page?: "home" | "posts" | "contact";
  description?: string;
}

const {
  title = "初咏的小窝",
  page = "home",
  description = "初咏的个人主页。Welcome to my little nest! 在同一片天空下认识新朋友，看看原创动态，找到联系方式。",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#eaf5ff" />
    <link rel="icon" type="image/png" href="/assets/site-favicon-2026-09-29.png" />
    {page === "posts" && (
      <>
        <link rel="preload" href="/assets/posts-winter-hero-q90.webp" as="image" type="image/webp" fetchpriority="high" />
        <link rel="preload" href="/api/x-posts" as="fetch" crossorigin="anonymous" />
      </>
    )}
    <meta name="description" content={description} />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (() => {
        function applyLanguage() {
          try {
            const saved = localStorage.getItem("site_language");
            if (saved && ["zh", "ja", "en"].includes(saved)) {
              document.documentElement.lang = saved === "zh" ? "zh-CN" : saved;
              document.documentElement.classList.remove("language-zh", "language-ja", "language-en");
              document.documentElement.classList.add("language-" + saved);
              const main = document.querySelector(".site");
              if (main) {
                main.classList.remove("language-zh", "language-ja", "language-en");
                main.classList.add("language-" + saved);
              }
            }
          } catch (_) {}
        }
        applyLanguage();
        document.addEventListener("astro:after-swap", applyLanguage);
      })();
    </script>
  </head>
  <body>
    <main class={`site language-zh ${page === "home" ? "" : "site-route site-route-" + page}`}>
      {page === "posts" && <div class="route-floating-elements" aria-hidden="true" />}
      {page === "contact" && (
        <div class="route-floating-elements" aria-hidden="true">
          <img class="route-floating-dove" src={`${ASSETS}/contact-sky-dove-v2.png`} alt="" draggable="false" />
        </div>
      )}

      <slot />

      <ClickSparkles client:load />
    </main>
  </body>
</html>
