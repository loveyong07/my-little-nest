{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "jsx": "react-jsx",
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true
  },
  "include": ["types/**/*.d.ts", "shared/**/*.mjs", "server/**/*.mjs", "api/*.js", "src/**/*.js", "src/**/*.jsx"]
}
