{
  "name": "my-little-nest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:proxy": "node --use-env-proxy ./node_modules/vite/bin/vite.js",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "preview:proxy": "node --use-env-proxy ./node_modules/vite/bin/vite.js preview",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/*.test.mjs",
    "test:build": "node --test tests/build/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:browser": "node scripts/qa/site-regressions.mjs && node scripts/qa/article-images.mjs",
    "audit:ci": "npm audit --audit-level=moderate && node scripts/audit-dependencies.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0 && npm run lint:css",
    "lint:css": "biome lint src --error-on-warnings && node scripts/check-css-syntax.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "qa:styles": "node scripts/qa/style-snapshot.mjs",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test:unit && npm run build && npm run test:build && npm run test:sites"
  },
  "dependencies": {
    "@fontsource/quicksand": "5.3.0",
    "@fontsource/zcool-kuaile": "^5.3.0",
    "@vercel/blob": "2.9.0",
    "@vercel/functions": "3.11.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "sharp": "0.35.5"
  },
  "overrides": {
    "picomatch": "$picomatch",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@eslint/js": "^10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "css-tree": "3.2.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "picomatch": "file:vendor/picomatch",
    "pixelmatch": "^8.0.0",
    "playwright-core": "1.65.1",
    "pngjs": "^7.0.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
