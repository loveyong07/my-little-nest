{
  "name": "hello-nice-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "dev:proxy": "node --use-env-proxy ./node_modules/astro/bin/astro.js dev --host 127.0.0.1",
    "build": "astro build && node scripts/prepare-sites-build.mjs",
    "preview": "astro preview",
    "preview:proxy": "node --use-env-proxy ./node_modules/astro/bin/astro.js preview",
    "build:vite": "vite build && node scripts/prepare-sites-build.mjs",
    "dev:vite": "vite",
    "test": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@astrojs/vercel": "^11.0.11",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@upstash/redis": "^1.39.0",
    "@vitejs/plugin-react": "5.0.4",
    "astro": "^7.3.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.7.0",
    "vite": "6.4.2"
  }
}
